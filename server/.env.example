# Postgres connection string (required).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/harvest

# Separate Postgres database for the DBOS system tables (required).
DBOS_SYSTEM_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/harvest_dbos

# HTTP port (optional, default 3000).
PORT=3000

# Twilio Verify (optional). Set all three to use the real OTP provider;
# leave them unset to fall back to the in-process StubOtpProvider (dev/tests).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Apify API token (optional). Set it to use the real ApifyFetcher for
# Tier 1/2 social scraping; leave unset to fall back to StubApifyFetcher (tests).
APIFY_TOKEN=

# HikerAPI access key (optional). Set it to fetch Instagram posts via HikerAPI's
# fast private-media API (~1-2s) instead of the Apify actor. Non-Instagram
# platforms still use Apify.
HIKER_API_KEY=

# Groq API key (optional). Set it to use real Whisper ASR for video imports;
# leave unset to fall back to the offline stub (tests).
GROQ_API_KEY=

# DeepSeek API key (optional). Set it to use real recipe extraction
# (deepseek-v4-flash); leave unset to fall back to the offline stub (tests).
DEEPSEEK_API_KEY=

# LamaTok access key (optional). Set it to fetch TikTok posts via LamaTok's
# fast private-media API (caption, video, slideshow images); leave unset to fall
# back to the caption-only TikTok oEmbed.
LAMATOK_API_KEY=

# OpenAI — last-resort extractor tier + cuisine/meal-prep LLM (categorize, equipment). Code reads OPENAI_API_KEY.
OPENAI_API_KEY=
