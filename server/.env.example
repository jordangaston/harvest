# Postgres connection string (required).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/harvest

# Separate Postgres database for the DBOS system tables (required).
DBOS_SYSTEM_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/harvest_dbos

# HTTP port (optional, default 3000).
PORT=3000

# Twilio Verify (optional). Set all three to use the real OTP provider;
# leave them unset to fall back to the in-process StubOtpProvider (dev/tests).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Apify API token (optional). Set it to use the real ApifyFetcher for
# Tier 1/2 social scraping; leave unset to fall back to StubApifyFetcher (tests).
APIFY_TOKEN=
