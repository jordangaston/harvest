{
  "name": "@harvest/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:create": "tsx scripts/create-databases.ts",
    "db:generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "coverage": "vitest run --project unit --coverage"
  },
  "dependencies": {
    "@dbos-inc/dbos-sdk": "^4.25.14",
    "@dbos-inc/drizzle-datasource": "^4.25.14",
    "drizzle-orm": "^0.44.6",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "@types/pg": "^8.15.6",
    "@vitest/coverage-v8": "^3.2.4",
    "drizzle-kit": "^0.31.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
