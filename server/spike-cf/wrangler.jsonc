{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "harvest-cf",
  "main": "src/worker.ts",
  // 2026-08-14: Workflows + local dev supported. nodejs_compat keeps crypto/Buffer
  // shims available; @libsql/client/web itself is fetch-based and Node-free.
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workflows": [
    {
      "name": "harvest-import",
      "binding": "IMPORT_WORKFLOW",
      "class_name": "ImportWorkflow"
    }
  ],
  // Every import is enqueued: intake produces to IMPORT_QUEUE; the same Worker's
  // queue() consumer drains it and starts the Workflow. One queue, this Worker is
  // both producer and consumer (miniflare emulates it locally, offline).
  "queues": {
    "producers": [{ "queue": "harvest-import-queue", "binding": "IMPORT_QUEUE" }],
    "consumers": [
      {
        "queue": "harvest-import-queue",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "dead_letter_queue": "harvest-import-dlq"
      }
    ]
  }
  // The database is Turso (libSQL), reached over HTTP via @libsql/client/web — not
  // a Cloudflare binding. Connection comes from env: TURSO_DATABASE_URL (+
  // TURSO_AUTH_TOKEN for cloud). Local dev points it at a `turso dev` server via
  // .dev.vars; prod injects a Turso cloud URL + token via `wrangler secret put`.
}
